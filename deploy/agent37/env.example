# copy to env.production (git-ignored) and fill in from Vercel > Project > Settings > Environment Variables
# ("npx vercel env pull deploy/agent37/env.production --environment=production" does it in one go)
APP_URL=https://tryivyward.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
FRONT_PROXY_SECRET=   # any long random string; the same value goes in the Cloudflare worker
RESEND_API_KEY=
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
COMPOSIO_API_KEY=
TOKEN_ENCRYPTION_KEY=
# ...and every other variable listed in Vercel
