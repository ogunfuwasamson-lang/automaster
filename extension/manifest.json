{
  "manifest_version": 3,
  "name": "Ivyward runner",
  "version": "1.5.0",
  "description": "Finishes your approved university applications in your own Chrome. Shows every answer and asks before submitting.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "webNavigation",
    "sidePanel",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tryivyward.com/*",
        "https://www.tryivyward.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ivyward runner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://tryivyward.com",
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Open the Ivyward side panel"
    },
    "pause-all": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume the agents in this browser"
    }
  }
}
