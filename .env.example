# supabase: project settings -> api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# claude
ANTHROPIC_API_KEY=
# optional overrides
# AGENT_MODEL_DEEP=claude-opus-5-5
# AGENT_MODEL_FAST=claude-sonnet-5-5

# random long string. the worker endpoint only runs with this as a bearer token.
# generate: openssl rand -hex 32
CRON_SECRET=

# local tests only
# TEST_DATABASE_URL=postgres://user:pass@localhost/am_test

# public url of the app (used for oauth redirects and digest links)
APP_URL=https://tryivyward.com

# gmail sending (optional; without these, drafts open in the user's own email app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64 hex chars. encrypts gmail refresh tokens. generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# cloud runner (optional): use browserbase instead of chromium inside the function (gives a live view for bot checks)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# set to 0 to only ask gmail for send access (then portal verification codes are handed to the applicant)
# GMAIL_READ=1

# Ivyward's own email (digests, notices) and, via Supabase SMTP, sign-in emails. verify the domain in resend first.
RESEND_API_KEY=

# UserJot (feedback, roadmap, updates): project id from the UserJot dashboard, and the project secret from
# Settings > Login > Secrets, which signs the signed-in user so they skip UserJot's own sign-in
NEXT_PUBLIC_USERJOT_PROJECT_ID=
USERJOT_SECRET=
EMAIL_FROM="Ivyward <hello@tryivyward.com>"
EMAIL_REPLY_TO=

# gmail through composio's verified google app (dashboard.composio.dev → auth configs → gmail, composio managed)
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG=

# Bachs payments (africa pays per submission, elsewhere 3 free then $20/month). sk_sandbox_... for testing,
# sk_live_... for real money. the webhook secret is on the endpoint's page in the Bachs developer portal;
# point the endpoint at https://tryivyward.com/api/billing/webhook
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# optional: an existing monthly product id (otherwise one is created on first use)
# BACHS_PRO_PRODUCT=

# Cloudflare Turnstile (bot check on sign-in/sign-up). site key here; the secret goes in Supabase
# (Authentication > Attack Protection > CAPTCHA, provider Turnstile). set this before turning CAPTCHA on in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
